// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  profile       UserProfile?
  recommendations Recommendation[]
  watchedMovies WatchedMovie[]
  reviews       Review[]
  reviewLikes   ReviewLike[]
  movieLists    MovieList[]
  following       Follow[]       @relation("UserFollowing")
  followers       Follow[]       @relation("UserFollowers")
  conversationsA  Conversation[] @relation("ConvA")
  conversationsB  Conversation[] @relation("ConvB")
  sentMessages    Message[]      @relation("MsgSender")

  @@map("users")
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Preferences
  favoriteGenres  String   // JSON array of genre IDs
  favoriteDirectors String // JSON array of director IDs
  favoriteActors  String   // JSON array of actor IDs

  // Personal info (optional)
  displayName     String?
  birthDate       DateTime?
  country         String?
  language        String?
  avatarUrl       String?
  lastFollowerCheckAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_profiles")
}

model WatchedMovie {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tmdbId    String
  title     String
  rating    Int      // 1 (dislike) or 5 (like)
  
  createdAt DateTime @default(now())

  @@unique([userId, tmdbId])
  @@map("watched_movies")
}

model Recommendation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tmdbId          String
  title           String
  explanation     String
  genre           String
  year            Int
  contentType     String?  // "movie" or "tv" (from LLM)
  posterPath      String?  // TMDB poster path
  overview        String?  // TMDB synopsis

  // Context used for this recommendation
  contextMood     String?  // e.g., "mystery", "escape"
  contextType     String?  // "movie" or "series"
  contextDuration Int?     // max duration in minutes
  contextYear     Int?     // min year

  createdAt       DateTime @default(now())

  @@map("recommendations")
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId      String
  title       String
  contentType String
  rating      Int      // 1–5
  liked       Boolean?
  text        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  likes       ReviewLike[]

  @@unique([userId, tmdbId])
  @@map("reviews")
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int      // 1 = like, -1 = dislike
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@map("review_likes")
}

model MovieList {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean         @default(true)
  items       MovieListItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("movie_lists")
}

model MovieListItem {
  id          String    @id @default(cuid())
  listId      String
  list        MovieList @relation(fields: [listId], references: [id], onDelete: Cascade)
  tmdbId      String
  title       String
  posterPath  String?
  contentType String
  addedAt     DateTime  @default(now())

  @@unique([listId, tmdbId])
  @@map("movie_list_items")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

model Conversation {
  id           String    @id @default(cuid())
  participantA String
  participantB String
  userA        User      @relation("ConvA", fields: [participantA], references: [id], onDelete: Cascade)
  userB        User      @relation("ConvB", fields: [participantB], references: [id], onDelete: Cascade)
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@unique([participantA, participantB])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@map("messages")
}
