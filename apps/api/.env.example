# === Environment ===
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# === Database (Azure Database for PostgreSQL) ===
# Formato: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@your-server.postgres.database.azure.com:5432/recomendador_db?sslmode=require

# === Authentication ===
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
SESSION_SECRET=your-super-secret-session-key

# === External APIs ===
OPENAI_API_KEY=sk-...
HUGGINGFACE_API_TOKEN=hf_...
TMDB_API_KEY=your-tmdb-api-key
JUSTWATCH_API_KEY=your-justwatch-api-key

# === API Timeouts (milliseconds) ===
LLM_TIMEOUT_MS=10000
TMDB_TIMEOUT_MS=5000
JUSTWATCH_TIMEOUT_MS=5000
RECOMMENDATION_MAX_RETRIES=3

# === Redis (optional for E2+) ===
REDIS_URL=redis://localhost:6379

# === CORS ===
CORS_ORIGIN=http://localhost:3001
